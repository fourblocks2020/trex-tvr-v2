# Shared infrastructure + secrets (12-factor). Copy to config/.env and fill in.
# Real exported env vars always win over this file.

# --- trex-core RabbitMQ transport (shared broker) ---
TREX_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- kis-data-hub market data (shared endpoint + secret) ---
KIS_DATA_HUB_BASE_URL=http://localhost:8080
KIS_DATA_HUB_API_KEY=
KIS_DATA_HUB_ALLOW_STALE=false

# --- Redis (required: holiday cache + any per-strategy cache) ---
TREX_REDIS_URL=redis://localhost:6379/0
